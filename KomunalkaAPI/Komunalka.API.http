# Komunalka API HTTP Client
# Base URLs for different environments
@KomunalkaAPI_HostAddress = http://localhost:8080/api/v1
# @KomunalkaAPI_HostAddress = http://localhost:5242/api/v1
# @KomunalkaAPI_HostAddress = https://localhost:7095/api/v1

# JWT Token variables (update these after successful login)
# Example tokens from test user:
@jwt_token = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxIiwiZW1haWwiOiJ0ZXN0QGV4YW1wbGUuY29tIiwianRpIjoiNTE4ZTI0MTQtM2Y4OS00YzZkLWI1MzQtNDJhMzg1NDMzODY4IiwidW5pcXVlX25hbWUiOiJ0ZXN0dXNlciIsInJvbGUiOiJVc2VyIiwibmJmIjoxNzYxNzMzMTU3LCJleHAiOjE3NjE3MzQ5NTcsImlhdCI6MTc2MTczMzE1NywiaXNzIjoia29tdW5hbGthLWFwaSIsImF1ZCI6ImtvbXVuYWxrYS1jbGllbnQifQ.c_XtBhH8n_UvF4DWWMOo7TpoirJeVovOMTfpzPWBTMU
@refresh_token = c0YCDucdInwaIXd9V4fHnztbrgblXUFGAfOR4Qi5ssI=

### Authentication Endpoints

# Register new user
POST {{KomunalkaAPI_HostAddress}}/auth/register
Content-Type: application/json

{
  "username": "testuser",
  "email": "test@example.com",
  "password": "Password123",
  "confirmPassword": "Password123"
}

###

# Login user
POST {{KomunalkaAPI_HostAddress}}/auth/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "Password123"
}

###

# Refresh JWT Token
POST {{KomunalkaAPI_HostAddress}}/auth/refresh-token
Content-Type: application/json

{
  "refreshToken": "{{refresh_token}}"
}

###

# Revoke refresh token (requires authentication)
POST {{KomunalkaAPI_HostAddress}}/auth/revoke-token
Content-Type: application/json
Authorization: Bearer {{jwt_token}}

{
  "refreshToken": "{{refresh_token}}"
}

###

# Validate JWT token
GET {{KomunalkaAPI_HostAddress}}/auth/validate-token
Authorization: Bearer {{jwt_token}}

### User Management Endpoints

# Get all users (requires authentication)
GET {{KomunalkaAPI_HostAddress}}/users
Accept: application/json
Authorization: Bearer {{jwt_token}}

###

# Get user by ID (requires authentication)
GET {{KomunalkaAPI_HostAddress}}/users/1
Accept: application/json
Authorization: Bearer {{jwt_token}}

###

# Create new user (requires authentication)
POST {{KomunalkaAPI_HostAddress}}/users
Content-Type: application/json
Authorization: Bearer {{jwt_token}}

{
  "username": "newuser",
  "email": "newuser@example.com",
  "password": "password123"
}

###

# Update user (requires authentication)
PUT {{KomunalkaAPI_HostAddress}}/users/1
Content-Type: application/json
Authorization: Bearer {{jwt_token}}

{
  "username": "updateduser",
  "email": "updated@example.com",
  "password": "newpassword123"
}

###

# Delete user (requires authentication)
DELETE {{KomunalkaAPI_HostAddress}}/users/1
Authorization: Bearer {{jwt_token}}

### Address Management Endpoints
# Note: All address endpoints now work with user-specific addresses
# The same physical address can be shared by multiple users
# Each user can independently mark their addresses as primary using isPrimary flag

# Get all addresses with pagination (requires authentication)
# Returns only addresses associated with the current user
GET {{KomunalkaAPI_HostAddress}}/address?page=1&perPage=10
Accept: application/json
Authorization: Bearer {{jwt_token}}

###

# Get address by ID (requires authentication)
# Returns address only if current user has access to it
GET {{KomunalkaAPI_HostAddress}}/address/1
Accept: application/json
Authorization: Bearer {{jwt_token}}

###

# Create new address (requires authentication)
# If isPrimary is true, all other addresses for this user will be marked as non-primary
# addressTypeId: 1 = Квартира, 2 = Приватний будинок, 3 = Офіс
POST {{KomunalkaAPI_HostAddress}}/address
Content-Type: application/json
Authorization: Bearer {{jwt_token}}

{
  "regionId": 9,
  "city": "Київ",
  "street": "вул. Хрещатик",
  "buildingNumber": "1",
  "apartmentNumber": "101",
  "zipCode": "01001",
  "notes": "Центр міста",
  "isPrimary": true,
  "addressTypeId": 1
}

###

# Update address (requires authentication)
# If isPrimary is changed to true, all other addresses for this user will be marked as non-primary
# Only updates the address if current user has access to it
# addressTypeId: 1 = Квартира, 2 = Приватний будинок, 3 = Офіс
PUT {{KomunalkaAPI_HostAddress}}/address/1
Content-Type: application/json
Authorization: Bearer {{jwt_token}}

{
  "regionId": 9,
  "zipCode": "01001",
  "city": "Київ",
  "street": "вул. Хрещатик",
  "buildingNumber": "1",
  "apartmentNumber": "101",
  "notes": "Оновлені примітки",
  "isPrimary": true,
  "addressTypeId": 1
}

###

# Delete address (requires authentication)
# Removes the link between user and address
# If this was the last user linked to this address, the address is soft-deleted
DELETE {{KomunalkaAPI_HostAddress}}/address/1
Authorization: Bearer {{jwt_token}}

### Region Management Endpoints

# Get all regions (requires authentication)
GET {{KomunalkaAPI_HostAddress}}/region
Accept: application/json
Authorization: Bearer {{jwt_token}}

###

# Get region by ID (requires authentication)
GET {{KomunalkaAPI_HostAddress}}/region/9
Accept: application/json
Authorization: Bearer {{jwt_token}}

### Address Type Management Endpoints
# Updated: Address types now have Ukrainian names
# Available types: Квартира (1), Приватний будинок (2), Офіс (3)

# Get all address types (requires authentication)
GET {{KomunalkaAPI_HostAddress}}/addresstype
Accept: application/json
Authorization: Bearer {{jwt_token}}

###

# Get address type by ID (requires authentication)
# Example: ID 1 = "Квартира", ID 2 = "Приватний будинок", ID 3 = "Офіс"
GET {{KomunalkaAPI_HostAddress}}/addresstype/1
Accept: application/json
Authorization: Bearer {{jwt_token}}

### Meter Reading Management Endpoints

# Create meter reading without image (requires authentication)
POST {{KomunalkaAPI_HostAddress}}/meterreading
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW
Authorization: Bearer {{jwt_token}}

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="ServiceCounterId"

1
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="Value"

123.45
------WebKitFormBoundary7MA4YWxkTrZu0gW--

###

# Create meter reading with image (requires authentication)
# Note: Replace "path/to/meter-photo.jpg" with actual image path
POST {{KomunalkaAPI_HostAddress}}/meterreading
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW
Authorization: Bearer {{jwt_token}}

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="ServiceCounterId"

1
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="Value"

150.75
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="image"; filename="meter-photo.jpg"
Content-Type: image/jpeg

< ./path/to/meter-photo.jpg
------WebKitFormBoundary7MA4YWxkTrZu0gW--

###

# Get meter reading by ID with images (requires authentication)
GET {{KomunalkaAPI_HostAddress}}/meterreading/1
Accept: application/json
Authorization: Bearer {{jwt_token}}

###

# Get optimized image (public access)
GET {{KomunalkaAPI_HostAddress}}/meterreading/images/1/optimized

###

# Get thumbnail image (public access)
GET {{KomunalkaAPI_HostAddress}}/meterreading/images/1/thumbnail

###

# Delete meter reading with images (requires authentication)
DELETE {{KomunalkaAPI_HostAddress}}/meterreading/1
Authorization: Bearer {{jwt_token}}

###

### Currency Management Endpoints

# Get all currencies (requires authentication)
GET {{KomunalkaAPI_HostAddress}}/currency
Accept: application/json
Authorization: Bearer {{jwt_token}}

###

# Get currency by ID (requires authentication)
GET {{KomunalkaAPI_HostAddress}}/currency/2
Accept: application/json
Authorization: Bearer {{jwt_token}}

###

# Create new currency (requires authentication)
POST {{KomunalkaAPI_HostAddress}}/currency
Content-Type: application/json
Authorization: Bearer {{jwt_token}}

{
  "name": "US Dollar",
  "code": "USD",
  "symbol": "$"
}

###

# Update currency (requires authentication)
PUT {{KomunalkaAPI_HostAddress}}/currency/1
Content-Type: application/json
Authorization: Bearer {{jwt_token}}

{
  "name": "Euro",
  "code": "EUR",
  "symbol": "€"
}

###

# Delete currency (requires authentication)
DELETE {{KomunalkaAPI_HostAddress}}/currency/1
Authorization: Bearer {{jwt_token}}

