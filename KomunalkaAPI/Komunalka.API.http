###
# Create new address (requires authentication)
# If isPrimary is true, all other addresses for this user will be marked as non-primary
# addressTypeId: 1 = Квартира, 2 = Приватний будинок, 3 = Офіс
POST {{KomunalkaAPI_HostAddress}}/address
Content-Type: application/json
Authorization: Bearer {{jwt_token}}

{
  "regionId": 9,
  "city": "Київ",
  "street": "вул. Хрещатик",
  "buildingNumber": "1",
  "apartmentNumber": "101",
  "zipCode": "01001",
  "notes": "Центр міста",
  "isPrimary": true,
  "addressTypeId": 1
}

# Response 201 Created:
# {
#   "id": 1,
#   "userId": 1,
#   "regionId": 9,
#   "city": "Київ",
#   "street": "вул. Хрещатик",
#   "buildingNumber": "1",
#   "apartmentNumber": "101",
#   "zipCode": "01001",
#   "notes": "Центр міста",
#   "isPrimary": true,
#   "addressTypeId": 1,
#   "region": {
#     "id": 9,
#     "name": "Київська область",
#     "createdAt": "2025-01-01T00:00:00Z",
#     "updatedAt": "2025-01-01T00:00:00Z"
#   },
#   "addressType": {
#     "id": 1,
#     "name": "Квартира",
#     "description": "Багатоквартирний будинок у місті",
#     "icon": "apartment",
#     "createdAt": "2025-01-01T00:00:00Z",
#     "updatedAt": "2025-01-01T00:00:00Z"
#   },
#   "createdAt": "2025-02-05T10:30:00Z",
#   "updatedAt": "2025-02-05T10:30:00Z"
# }
#
# Response 400 Bad Request:
# {
#   "type": "https://tools.ietf.org/html/rfc9110#section-15.5.1",
#   "title": "One or more validation errors occurred.",
#   "status": 400,
#   "errors": {
#     "City": ["City is required"],
#     "RegionId": ["Invalid region ID"]
#   }
# }

###
# Update address (requires authentication)
# If isPrimary is changed to true, all other addresses for this user will be marked as non-primary
# Only updates the address if current user has access to it
# addressTypeId: 1 = Квартира, 2 = Приватний будинок, 3 = Офіс
PUT {{KomunalkaAPI_HostAddress}}/address/1
Content-Type: application/json
Authorization: Bearer {{jwt_token}}

{
  "regionId": 9,
  "zipCode": "01001",
  "city": "Київ",
  "street": "вул. Хрещатик",
  "buildingNumber": "1",
  "apartmentNumber": "101",
  "notes": "Оновлені примітки",
  "isPrimary": true,
  "addressTypeId": 1
}

# Response 200 OK:
# {
#   "id": 1,
#   "userId": 1,
#   "regionId": 9,
#   "city": "Київ",
#   "street": "вул. Хрещатик",
#   "buildingNumber": "1",
#   "apartmentNumber": "101",
#   "zipCode": "01001",
#   "notes": "Оновлені примітки",
#   "isPrimary": true,
#   "addressTypeId": 1,
#   "region": {
#     "id": 9,
#     "name": "Київська область",
#     "createdAt": "2025-01-01T00:00:00Z",
#     "updatedAt": "2025-01-01T00:00:00Z"
#   },
#   "addressType": {
#     "id": 1,
#     "name": "Квартира",
#     "description": "Багатоквартирний будинок у місті",
#     "icon": "apartment",
#     "createdAt": "2025-01-01T00:00:00Z",
#     "updatedAt": "2025-01-01T00:00:00Z"
#   },
#   "createdAt": "2025-01-15T10:30:00Z",
#   "updatedAt": "2025-02-05T10:35:00Z"
# }
#
# Response 404 Not Found:
# {
#   "type": "https://tools.ietf.org/html/rfc9110#section-15.5.5",
#   "title": "Not Found",
#   "status": 404,
#   "detail": "Address with ID 999 not found or you don't have access"
# }

###
# Delete address (requires authentication)
# Removes the link between user and address
# If this was the last user linked to this address, the address is soft-deleted
DELETE {{KomunalkaAPI_HostAddress}}/address/1
Authorization: Bearer {{jwt_token}}

# Response 204 No Content
#
# Response 404 Not Found:
# {
#   "type": "https://tools.ietf.org/html/rfc9110#section-15.5.5",
#   "title": "Not Found",
#   "status": 404,
#   "detail": "Address with ID 1 not found or you don't have access"
# }

