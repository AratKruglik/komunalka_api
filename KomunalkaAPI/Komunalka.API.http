###
# Create new meter with photo (requires authentication)
# Note: Replace "./path/to/meter-photo.jpg" with actual image path
POST {{KomunalkaAPI_HostAddress}}/meter
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW
Authorization: Bearer {{jwt_token}}

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="AddressId"

1
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="UtilityTypeId"

2
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="Name"

Лічильник газу
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="SerialNumber"

GZ98765432
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="ModelName"

Metrix G4
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="Location"

У коридорі на стіні
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="InstallationDate"

2024-02-20
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="InitialReading"

250.0
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="ServiceProviderId"

1
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="Notes"

Встановлено та опломбовано газовою службою
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="IsActive"

true
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="photo"; filename="meter-photo.jpg"
Content-Type: image/jpeg

< ./path/to/meter-photo.jpg
------WebKitFormBoundary7MA4YWxkTrZu0gW--

# Response 201 Created:
# {
#   "id": 2,
#   "addressId": 1,
#   "utilityTypeId": 2,
#   "serialNumber": "GZ98765432",
#   "name": "Лічильник газу",
#   "description": null,
#   "modelName": "Metrix G4",
#   "location": "У коридорі на стіні",
#   "photoPath": "uploads/meters/meter_2_photo.jpg",
#   "installationDate": "2024-02-20T00:00:00Z",
#   "initialReading": 250.0,
#   "serviceProviderId": 1,
#   "notes": "Встановлено та опломбовано газовою службою",
#   "isActive": true,
#   "createdAt": "2025-02-05T10:05:00Z",
#   "updatedAt": "2025-02-05T10:05:00Z",
#   "utilityTypeName": "Газ",
#   "serviceProviderName": "Київгаз"
# }

###
# Update meter (requires authentication)
PUT {{KomunalkaAPI_HostAddress}}/meter/1
Content-Type: application/json
Authorization: Bearer {{jwt_token}}

{
  "serialNumber": "AB12345678-NEW",
  "name": "Лічильник електроенергії (оновлено)",
  "modelName": "НІК 2102-01",
  "location": "На кухні біля дверей (ліва стіна)",
  "notes": "Пройшов повірку 2024-11-25",
  "isActive": true
}

# Response 200 OK:
# {
#   "id": 1,
#   "addressId": 1,
#   "utilityTypeId": 1,
#   "serialNumber": "AB12345678-NEW",
