###
# Create new currency (requires authentication)
POST {{KomunalkaAPI_HostAddress}}/currency
Content-Type: application/json
Authorization: Bearer {{jwt_token}}

{
  "name": "US Dollar",
  "code": "USD",
  "symbol": "$"
}

# Response 201 Created:
# {
#   "id": 2,
#   "code": "USD",
#   "name": "US Dollar",
#   "symbol": "$",
#   "createdAt": "2025-02-05T10:00:00Z",
#   "updatedAt": "2025-02-05T10:00:00Z"
# }
#
# Response 400 Bad Request:
# {
#   "type": "https://tools.ietf.org/html/rfc9110#section-15.5.1",
#   "title": "One or more validation errors occurred.",
#   "status": 400,
#   "errors": {
#     "Code": ["Currency code is required", "Currency code must be 3 characters"],
#     "Name": ["Currency name is required"]
#   }
# }

###
# Update currency (requires authentication)
PUT {{KomunalkaAPI_HostAddress}}/currency/1
Content-Type: application/json
Authorization: Bearer {{jwt_token}}

{
  "name": "Euro",
  "code": "EUR",
  "symbol": "€"
}

# Response 200 OK:
# {
#   "id": 1,
#   "code": "EUR",
#   "name": "Euro",
#   "symbol": "€",
#   "createdAt": "2025-01-01T00:00:00Z",
#   "updatedAt": "2025-02-05T10:05:00Z"
# }
#
# Response 404 Not Found:
# {
#   "type": "https://tools.ietf.org/html/rfc9110#section-15.5.5",
#   "title": "Not Found",
#   "status": 404,
#   "detail": "Currency with ID 999 not found"
# }

###
# Delete currency (requires authentication)
DELETE {{KomunalkaAPI_HostAddress}}/currency/1
Authorization: Bearer {{jwt_token}}

# Response 204 No Content
#
# Response 404 Not Found:
# {
#   "type": "https://tools.ietf.org/html/rfc9110#section-15.5.5",
#   "title": "Not Found",
#   "status": 404,
#   "detail": "Currency with ID 1 not found"
# }
#
# Response 400 Bad Request (if currency is in use):
# {
#   "type": "https://tools.ietf.org/html/rfc9110#section-15.5.1",
#   "title": "Bad Request",
#   "status": 400,
#   "detail": "Cannot delete currency that is in use by tariffs"
# }

