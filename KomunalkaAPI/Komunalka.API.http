### Komunalka API HTTP Client
# Base URLs for different environments (uncomment the one you need)
@KomunalkaAPI_HostAddress = http://localhost:8080/api/v1
# @KomunalkaAPI_HostAddress = http://localhost:5242/api/v1
# @KomunalkaAPI_HostAddress = https://localhost:7095/api/v1

# JWT Token variables (update these after successful login)
# Example tokens from test user:
@jwt_token = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxIiwiZW1haWwiOiJ0ZXN0QGV4YW1wbGUuY29tIiwianRpIjoiNDA2NjM3NTUtOTA2OS00OGZjLWE4ZDUtMWQzYWI3NjdkNzhmIiwidW5pcXVlX25hbWUiOiJ0ZXN0dXNlciIsInJvbGUiOiJVc2VyIiwibmJmIjoxNzY0OTMyODc2LCJleHAiOjE3NjQ5MzQ2NzYsImlhdCI6MTc2NDkzMjg3NiwiaXNzIjoia29tdW5hbGthLWFwaSIsImF1ZCI6ImtvbXVuYWxrYS1jbGllbnQifQ.1pGnQzsQycW21X4wczQqYX8yU-7rujI91Y9pfXW3gv4
@refresh_token = c0YCDucdInwaIXd9V4fHnztbrgblXUFGAfOR4Qi5ssI=

### ============================================================================
### Authentication Endpoints
### ============================================================================

###
# Register new user
POST {{KomunalkaAPI_HostAddress}}/auth/register
Content-Type: application/json

{
  "username": "testuser",
  "firstName": "Олена",
  "lastName": "Петренко",
  "phoneNumber": "+380501234567",
  "email": "test@example.com",
  "password": "Password123",
  "confirmPassword": "Password123"
}

# Response 201 Created:
# {
#   "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
#   "refreshToken": "c0YCDucdInwaIXd9V4fHnztbrgblXUFGAfOR4Qi5ssI=",
#   "expiration": "2025-02-05T12:30:00Z",
#   "userId": 1,
#   "username": "testuser",
#   "email": "test@example.com",
#   "role": "User",
#   "authProvider": "Local",
#   "emailVerified": false
# }
#
# Response 400 Bad Request (validation error):
# {
#   "type": "https://tools.ietf.org/html/rfc9110#section-15.5.1",
#   "title": "One or more validation errors occurred.",
#   "status": 400,
#   "errors": {
#     "Email": ["Email is already taken"],
#     "Password": ["Password must be at least 8 characters"]
#   }
# }

###
# Login user
POST {{KomunalkaAPI_HostAddress}}/auth/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "Password123"
}

# Response 200 OK:
# {
#   "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
#   "refreshToken": "c0YCDucdInwaIXd9V4fHnztbrgblXUFGAfOR4Qi5ssI=",
#   "expiration": "2025-02-05T12:30:00Z",
#   "userId": 1,
#   "username": "testuser",
#   "email": "test@example.com",
#   "role": "User",
#   "authProvider": "Local",
#   "emailVerified": true
# }
#
# Response 401 Unauthorized:
# {
#   "type": "https://tools.ietf.org/html/rfc9110#section-15.5.2",
#   "title": "Unauthorized",
#   "status": 401,
#   "detail": "Invalid email or password"
# }

###
# Refresh JWT Token
POST {{KomunalkaAPI_HostAddress}}/auth/refresh-token
Content-Type: application/json

{
  "refreshToken": "{{refresh_token}}"
}

# Response 200 OK:
# {
#   "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
#   "refreshToken": "newRefreshToken123=",
#   "expiration": "2025-02-05T13:00:00Z",
#   "userId": 1,
#   "username": "testuser",
#   "email": "test@example.com",
#   "role": "User",
#   "authProvider": "Local",
#   "emailVerified": true
# }
#
# Response 401 Unauthorized:
# {
#   "type": "https://tools.ietf.org/html/rfc9110#section-15.5.2",
#   "title": "Unauthorized",
#   "status": 401,
#   "detail": "Invalid or expired refresh token"
# }

###
# Revoke refresh token (requires authentication)
POST {{KomunalkaAPI_HostAddress}}/auth/revoke-token
Content-Type: application/json
Authorization: Bearer {{jwt_token}}

{
  "refreshToken": "{{refresh_token}}"
}

# Response 200 OK:
# {
#   "message": "Token revoked successfully"
# }
#
# Response 400 Bad Request:
# {
#   "type": "https://tools.ietf.org/html/rfc9110#section-15.5.1",
#   "title": "Bad Request",
#   "status": 400,
#   "detail": "Token not found or already revoked"
# }

###
# Validate JWT token
GET {{KomunalkaAPI_HostAddress}}/auth/validate-token
Authorization: Bearer {{jwt_token}}

# Response 200 OK:
# {
#   "valid": true,
#   "userId": 1,
#   "email": "test@example.com",
#   "username": "testuser",
#   "role": "User",
#   "expiresAt": "2025-02-05T12:30:00Z"
# }
#
# Response 401 Unauthorized:
# {
#   "type": "https://tools.ietf.org/html/rfc9110#section-15.5.2",
#   "title": "Unauthorized",
#   "status": 401,
#   "detail": "Invalid or expired token"
# }

### ============================================================================
### OAuth Authentication Endpoints
### ============================================================================

###
# Get Google OAuth authorization URL
GET {{KomunalkaAPI_HostAddress}}/auth/oauth/google/authorize

# Response 200 OK:
# {
#   "authorizationUrl": "https://accounts.google.com/o/oauth2/v2/auth?client_id=...&redirect_uri=...&response_type=code&scope=openid%20email%20profile&state=random_state_value"
# }

###
# Get GitHub OAuth authorization URL
GET {{KomunalkaAPI_HostAddress}}/auth/oauth/github/authorize

# Response 200 OK:
# {
#   "authorizationUrl": "https://github.com/login/oauth/authorize?client_id=...&redirect_uri=...&scope=user:email&state=random_state_value"
# }

###
# OAuth login with ID token (Google) or access token (GitHub)
# Provider: "Google" or "GitHub"
POST {{KomunalkaAPI_HostAddress}}/auth/oauth/login
Content-Type: application/json

{
  "provider": "Google",
  "token": "your-id-token-or-access-token"
}

# Response 200 OK (existing user):
# {
#   "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
#   "refreshToken": "oauthRefreshToken123=",
#   "expiration": "2025-02-05T12:30:00Z",
#   "userId": 1,
#   "username": "googleuser",
#   "email": "user@gmail.com",
#   "role": "User",
#   "authProvider": "Google",
#   "emailVerified": true
# }
#
# Response 201 Created (new user auto-created):
# {
#   "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
#   "refreshToken": "oauthRefreshToken123=",
#   "expiration": "2025-02-05T12:30:00Z",
#   "userId": 5,
#   "username": "john_doe_google",
#   "email": "john@gmail.com",
#   "role": "User",
#   "authProvider": "Google",
#   "emailVerified": true
# }
#
# Response 401 Unauthorized:
# {
#   "type": "https://tools.ietf.org/html/rfc9110#section-15.5.2",
#   "title": "Unauthorized",
#   "status": 401,
#   "detail": "Invalid OAuth token"
# }

###
# OAuth callback (authorization code flow)
POST {{KomunalkaAPI_HostAddress}}/auth/oauth/callback
Content-Type: application/json

{
  "provider": "GitHub",
  "code": "authorization-code-from-provider",
  "state": "state-parameter"
}

# Response 200 OK:
# {
#   "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
#   "refreshToken": "githubRefreshToken123=",
#   "expiration": "2025-02-05T12:30:00Z",
#   "userId": 2,
#   "username": "githubuser",
#   "email": "user@github.com",
#   "role": "User",
#   "authProvider": "GitHub",
#   "emailVerified": true
# }
#
# Response 400 Bad Request:
# {
#   "type": "https://tools.ietf.org/html/rfc9110#section-15.5.1",
#   "title": "Bad Request",
#   "status": 400,
#   "detail": "Invalid authorization code or state mismatch"
# }

###
# Link OAuth provider to existing account (requires authentication)
POST {{KomunalkaAPI_HostAddress}}/auth/oauth/link
Content-Type: application/json
Authorization: Bearer {{jwt_token}}

{
  "provider": "GitHub",
  "token": "your-access-token"
}

# Response 200 OK:
# {
#   "message": "GitHub account linked successfully",
#   "linkedProviders": ["Local", "GitHub"]
# }
#
# Response 400 Bad Request:
# {
#   "type": "https://tools.ietf.org/html/rfc9110#section-15.5.1",
#   "title": "Bad Request",
#   "status": 400,
#   "detail": "This GitHub account is already linked to another user"
# }

###
# Unlink OAuth provider from account (requires authentication)
DELETE {{KomunalkaAPI_HostAddress}}/auth/oauth/unlink/GitHub
Authorization: Bearer {{jwt_token}}

# Response 200 OK:
# {
#   "message": "GitHub account unlinked successfully",
#   "linkedProviders": ["Local"]
# }
#
# Response 400 Bad Request:
# {
#   "type": "https://tools.ietf.org/html/rfc9110#section-15.5.1",
#   "title": "Bad Request",
#   "status": 400,
#   "detail": "Cannot unlink the only authentication method"
# }

### ============================================================================
### User Management Endpoints
### ============================================================================

###
# Get all users (requires authentication)
GET {{KomunalkaAPI_HostAddress}}/users
Accept: application/json
Authorization: Bearer {{jwt_token}}

# Response 200 OK:
# [
#   {
#     "id": 1,
#     "username": "testuser",
#     "firstName": "Олена",
#     "lastName": "Петренко",
#     "phoneNumber": "+380501234567",
#     "email": "test@example.com",
#     "avatarUrl": "http://localhost:8080/api/v1/users/1/avatar",
#     "avatarThumbnailUrl": "http://localhost:8080/api/v1/users/1/avatar/thumbnail",
#     "addresses": [
#       {
#         "id": 1,
#         "userId": 1,
#         "regionId": 9,
#         "city": "Київ",
#         "street": "вул. Хрещатик",
#         "buildingNumber": "1",
#         "apartmentNumber": "101",
#         "zipCode": "01001",
#         "notes": "Центр міста",
#         "isPrimary": true,
#         "addressTypeId": 1,
#         "region": {
#           "id": 9,
#           "name": "Київська область",
#           "createdAt": "2025-01-01T00:00:00Z",
#           "updatedAt": "2025-01-01T00:00:00Z"
#         },
#         "addressType": {
#           "id": 1,
#           "name": "Квартира",
#           "description": "Багатоквартирний будинок у місті",
#           "icon": "apartment",
#           "createdAt": "2025-01-01T00:00:00Z",
#           "updatedAt": "2025-01-01T00:00:00Z"
#         },
#         "createdAt": "2025-01-15T10:30:00Z",
#         "updatedAt": "2025-01-15T10:30:00Z"
#       }
#     ],
#     "createdAt": "2025-01-10T10:00:00Z",
#     "updatedAt": "2025-01-15T10:30:00Z"
#   }
# ]

###
# Get user by ID (requires authentication)
GET {{KomunalkaAPI_HostAddress}}/users/1
Accept: application/json
Authorization: Bearer {{jwt_token}}

