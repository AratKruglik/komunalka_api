### Batch Meter Readings Management Endpoints
# New: Submit multiple meter readings at once with automatic cost calculation

# Submit batch meter readings for an address (requires authentication)
# Automatically calculates consumption and cost based on effective tariffs
POST {{KomunalkaAPI_HostAddress}}/meter-readings/batch
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW
Authorization: Bearer {{jwt_token}}

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="AddressId"

1
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="ReadingsJson"

{
  "addressId": 1,
  "readings": [
    {
      "meterId": 1,
      "readingValue": 5097,
      "readingDate": "2025-11-25T00:00:00Z",
      "notes": "Електроенергія",
      "isEstimated": false
    },
    {
      "meterId": 2,
      "readingValue": 606,
      "readingDate": "2025-11-25T00:00:00Z",
      "notes": "Газ",
      "isEstimated": false
    },
    {
      "meterId": 3,
      "readingValue": 99,
      "readingDate": "2025-11-25T00:00:00Z",
      "notes": "Гаряча вода",
      "isEstimated": false
    }
  ]
}
------WebKitFormBoundary7MA4YWxkTrZu0gW--

###

