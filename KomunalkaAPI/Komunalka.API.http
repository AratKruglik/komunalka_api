###
# Create new user (requires authentication)
POST {{KomunalkaAPI_HostAddress}}/users
Content-Type: application/json
Authorization: Bearer {{jwt_token}}

{
  "username": "newuser",
  "email": "newuser@example.com",
  "password": "password123"
}

# Response 201 Created:
# {
#   "id": 2,
#   "username": "newuser",
#   "firstName": null,
#   "lastName": null,
#   "phoneNumber": null,
#   "email": "newuser@example.com",
#   "avatarUrl": null,
#   "avatarThumbnailUrl": null,
#   "addresses": [],
#   "createdAt": "2025-02-05T10:05:00Z",
#   "updatedAt": "2025-02-05T10:05:00Z"
# }
#
# Response 400 Bad Request:
# {
#   "type": "https://tools.ietf.org/html/rfc9110#section-15.5.1",
#   "title": "One or more validation errors occurred.",
#   "status": 400,
#   "errors": {
#     "Email": ["Email is already taken"],
#     "Username": ["Username is already taken"]
#   }
# }

###
# Update user without password change (requires authentication)
PUT {{KomunalkaAPI_HostAddress}}/users/1
Content-Type: application/json
Authorization: Bearer {{jwt_token}}

{
  "username": "updateduser",
  "firstName": "Олена",
  "lastName": "Іваненко",
  "phoneNumber": "+380501234567",
  "email": "updated@example.com"
}

# Response 200 OK:
# {
#   "id": 1,
#   "username": "updateduser",
#   "firstName": "Олена",
#   "lastName": "Іваненко",
#   "phoneNumber": "+380501234567",
#   "email": "updated@example.com",
#   "avatarUrl": "http://localhost:8080/api/v1/users/1/avatar",
#   "avatarThumbnailUrl": "http://localhost:8080/api/v1/users/1/avatar/thumbnail",
#   "addresses": [],
#   "createdAt": "2025-01-10T10:00:00Z",
#   "updatedAt": "2025-02-05T10:15:00Z"
# }
#
# Response 404 Not Found:
# {
#   "type": "https://tools.ietf.org/html/rfc9110#section-15.5.5",
#   "title": "Not Found",
#   "status": 404,
#   "detail": "User with ID 999 not found"
# }

###
# Update user WITH password change (requires authentication)
# Password requirements:
# - Minimum 8 characters
# - At least 1 uppercase letter
# - At least 1 lowercase letter
# - At least 1 digit
PUT {{KomunalkaAPI_HostAddress}}/users/1
Content-Type: application/json
Authorization: Bearer {{jwt_token}}

{
  "username": "updateduser",
  "firstName": "Олена",
  "lastName": "Петренко",
  "phoneNumber": "+380501234567",
  "email": "updated@example.com",
  "currentPassword": "Password123",
  "newPassword": "NewPassword456",
  "confirmNewPassword": "NewPassword456"
}

# Response 200 OK:
# {
#   "id": 1,
#   "username": "updateduser",
#   "firstName": "Олена",
#   "lastName": "Петренко",
#   "phoneNumber": "+380501234567",
#   "email": "updated@example.com",
#   "avatarUrl": "http://localhost:8080/api/v1/users/1/avatar",
#   "avatarThumbnailUrl": "http://localhost:8080/api/v1/users/1/avatar/thumbnail",
#   "addresses": [],
#   "createdAt": "2025-01-10T10:00:00Z",
#   "updatedAt": "2025-02-05T10:20:00Z"
# }
#
# Response 400 Bad Request:
# {
#   "type": "https://tools.ietf.org/html/rfc9110#section-15.5.1",
#   "title": "Bad Request",
#   "status": 400,
#   "detail": "Current password is incorrect"
# }

###
# Update user WITH avatar upload (requires authentication)
# Allowed image types: JPG, JPEG, PNG, GIF, HEIC; max size 2 MB
# Replace ./path/to/avatar.jpg with an existing small test image on your machine
PUT {{KomunalkaAPI_HostAddress}}/users/1
Authorization: Bearer {{jwt_token}}
Content-Type: multipart/form-data; boundary=AvatarBoundary

--AvatarBoundary
Content-Disposition: form-data; name="username"

updateduser
--AvatarBoundary
Content-Disposition: form-data; name="firstName"

Олена
--AvatarBoundary
Content-Disposition: form-data; name="lastName"

Петренко
--AvatarBoundary
Content-Disposition: form-data; name="phoneNumber"

+380501234567
--AvatarBoundary
Content-Disposition: form-data; name="email"

updated@example.com
--AvatarBoundary
Content-Disposition: form-data; name="avatar"; filename="avatar.jpg"
Content-Type: image/jpeg

< ./path/to/avatar.jpg
--AvatarBoundary--

# Response 200 OK:
# {
#   "id": 1,
#   "username": "updateduser",
#   "firstName": "Олена",
#   "lastName": "Петренко",
#   "phoneNumber": "+380501234567",
#   "email": "updated@example.com",
#   "avatarUrl": "http://localhost:8080/api/v1/users/1/avatar",
#   "avatarThumbnailUrl": "http://localhost:8080/api/v1/users/1/avatar/thumbnail",
#   "addresses": [],
#   "createdAt": "2025-01-10T10:00:00Z",
#   "updatedAt": "2025-02-05T10:25:00Z"
# }
#
# Response 400 Bad Request (invalid file):
# {
#   "type": "https://tools.ietf.org/html/rfc9110#section-15.5.1",
#   "title": "Bad Request",
#   "status": 400,
#   "detail": "File size exceeds 2MB limit"
# }

###
# Get user avatar (optimized)
GET {{KomunalkaAPI_HostAddress}}/users/1/avatar
Authorization: Bearer {{jwt_token}}

# Response 200 OK: binary JPEG stream (optimized, oriented/stripped EXIF)
# Content-Type: image/jpeg
#
# Response 404 Not Found:
# {
#   "type": "https://tools.ietf.org/html/rfc9110#section-15.5.5",
#   "title": "Not Found",
#   "status": 404,
#   "detail": "Avatar not found for user 1"
# }

###
# Get user avatar (thumbnail)
GET {{KomunalkaAPI_HostAddress}}/users/1/avatar/thumbnail
Authorization: Bearer {{jwt_token}}

# Response 200 OK: binary JPEG thumbnail stream (150x150)
# Content-Type: image/jpeg
#
# Response 404 Not Found:
# {
#   "type": "https://tools.ietf.org/html/rfc9110#section-15.5.5",
#   "title": "Not Found",
#   "status": 404,
#   "detail": "Avatar not found for user 1"
# }

###
# Delete user (requires authentication)
DELETE {{KomunalkaAPI_HostAddress}}/users/1
Authorization: Bearer {{jwt_token}}

# Response 204 No Content
#
# Response 404 Not Found:
# {
#   "type": "https://tools.ietf.org/html/rfc9110#section-15.5.5",
#   "title": "Not Found",
#   "status": 404,
#   "detail": "User with ID 1 not found"
# }

### ============================================================================
### Address Management Endpoints
### ============================================================================

###
# Get all addresses with pagination (requires authentication)
# Returns only addresses associated with the current user
GET {{KomunalkaAPI_HostAddress}}/address?page=1&perPage=10
Accept: application/json
Authorization: Bearer {{jwt_token}}

# Response 200 OK (Laravel-compatible pagination format):
# {
#   "data": [
#     {
#       "id": 1,
#       "userId": 1,
#       "regionId": 9,
#       "city": "Київ",
#       "street": "вул. Хрещатик",
#       "buildingNumber": "1",
#       "apartmentNumber": "101",
#       "zipCode": "01001",
#       "notes": "Центр міста",
#       "isPrimary": true,
#       "addressTypeId": 1,
#       "region": {
#         "id": 9,
#         "name": "Київська область",
#         "createdAt": "2025-01-01T00:00:00Z",
#         "updatedAt": "2025-01-01T00:00:00Z"
#       },
#       "addressType": {
#         "id": 1,
#         "name": "Квартира",
#         "description": "Багатоквартирний будинок у місті",
