# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=komunalka
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=your_secure_password_here

# JWT Configuration
# ВАЖЛИВО: Згенеруйте безпечний секрет для production (мінімум 64 символи)
# Команда для генерації: openssl rand -base64 64
JWT_SECRET=your_jwt_secret_key_here_minimum_64_characters_long_CHANGE_THIS_IN_PRODUCTION
JWT_ISSUER=komunalka-api
JWT_AUDIENCE=komunalka-client
JWT_EXPIRATION_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7

# Environment
ASPNETCORE_ENVIRONMENT=Development

# HTTPS and HTTP Ports
ASPNETCORE_HTTPS_PORT=7095
ASPNETCORE_HTTP_PORT=5242

# CORS Configuration
# Список дозволених origins через кому (наприклад: http://localhost:3000,https://yourdomain.com)
# Для development можна використати * але в production ОБОВ'ЯЗКОВО вказати конкретні домени
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
