# Copy this file to deploy/.env on the server and adjust secrets before running the workflow.

# Database Configuration
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DATABASE=komunalka
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=change_me

# JWT Configuration (must match values provisioned for the API)
JWT_SECRET=replace_with_secure_secret
JWT_ISSUER=komunalka-api
JWT_AUDIENCE=komunalka-client
JWT_EXPIRATION_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7

# ASP.NET Core settings
ASPNETCORE_ENVIRONMENT=Production
CORS_ALLOWED_ORIGINS=https://your-frontend.example.com

# Optional: pgAdmin access (override defaults if you enable the service)
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=change_me_too
